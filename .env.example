DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
TRANSCRIPT_CHANNEL_ID=123456789012345678
FWS_BASE_URL=http://localhost:8000
# Codex セッション保存先（デフォルト: data/codex_sessions.json）
CODEX_STATE_PATH=data/codex_sessions.json
# スレッド名生成に Gemini を使う場合のみ設定（未設定でも動作します）
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# /alarm (Home Assistant) を使う場合に設定
HOME_ASSISTANT_BASE_URL=https://example.ui.nabu.casa
HOME_ASSISTANT_TOKEN=YOUR_LONG_LIVED_TOKEN
# Home Assistant automation で受け取るイベント名（未設定時は discord_alarm）
HOME_ASSISTANT_ALARM_EVENT=discord_alarm
# Codex / LLM 設定（デフォルトは gpt-5.1 と reasoning minimal）
CODEX_MODEL=gpt-5.1
CODEX_REASONING_EFFORT=minimal
# Codex の作業ディレクトリ（未設定なら bot 起動ディレクトリ）。~ は自動展開されます。
CODEX_WORKDIR=~/pikahome-work
